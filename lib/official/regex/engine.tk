import core/option::{Option}
import core/result::{Result}
import std/vec::{Vec}
pub import official/regex/model::{Captures, Match, Regex, RegexError}
import official/regex/model::{SearchResult}
import official/regex/syntax::{compile_program}
import official/regex/automata::{search_program}

const STATE_CAPTURE_NAME: i32 = 9:i32

impl RegexError {
    pub fn position(self) -> usize { return self.position }

    pub fn message(self) -> string { return string::from(self.message.as_str()) }
}

impl Match {
    pub fn start_offset(self) -> usize { return self.begin_byte }

    pub fn end_offset(self) -> usize { return self.end_byte }
}

impl Captures {
    pub fn len(self) -> usize { return self.groups.len() + 1:usize }

    pub fn whole_match(self) -> Match { return self.matched }

    pub fn get(self, index: usize) -> Option<Match> {
        if index == 0:usize { return Option<Match>::Some(self.matched) }
        if index > self.groups.len() { return Option<Match>::None }
        return self.groups.get(index - 1:usize)
    }

    pub fn name(self, name: str) -> Option<Match> {
        auto index# = 0:usize
        loop index < self.names.len() {
            auto *candidate = self.names.get_ref(index)
            if candidate.as_str().equals(name) {
                return self.groups.get(index)
            }
            index = index + 1:usize
        }
        return Option<Match>::None
    }
}

impl Regex {
    pub fn compile(pattern: str) -> Result<Regex, RegexError> {
        return compile_program(pattern)
    }

    fn search_from(self, input: str, start_byte: usize) -> Option<SearchResult> {
        return search_program(self.program, self.classes, self.entry, self.capture_count,
                              input, start_byte)
    }

    fn find_from(self, input: str, start_byte: usize) -> Option<Match> {
        auto found = self.search_from(input, start_byte)
        if found.is_none() { return Option<Match>::None }
        return Option<Match>::Some(found.unwrap().matched)
    }

    pub fn find(self, input: str) -> Option<Match> {
        return self.find_from(input, 0:usize)
    }

    pub fn captures(self, input: str) -> Option<Captures> {
        auto found = self.search_from(input, 0:usize)
        if found.is_none() { return Option<Captures>::None }
        auto result = found.unwrap()
        auto groups# = Vec<Option<Match>>::new()
        auto names# = Vec<string>::new()
        auto index# = 0:usize
        loop index < self.capture_count {
            auto start = result.captures.get(index * 2:usize)
            auto end = result.captures.get(index * 2:usize + 1:usize)
            if start < 0:i32 || end < 0:i32 {
                groups#.push(Option<Match>::None)
            } else {
                groups#.push(Option<Match>::Some(Match(
                    begin_byte = start as usize,
                    end_byte = end as usize
                )))
            }
            auto name# = string::from("")
            auto state_index# = 0:usize
            loop state_index < self.program.len() {
                auto *state = self.program.get_ref(state_index)
                if state.kind == STATE_CAPTURE_NAME && state.class_id == index as i32 {
                    name#.push_byte_raw(state.byte)
                }
                state_index = state_index + 1:usize
            }
            names#.push(cede name)
            index = index + 1:usize
        }
        return Option<Captures>::Some(Captures(
            matched = result.matched,
            groups = cede groups,
            names = cede names
        ))
    }

    pub fn find_all(self, input: str) -> Vec<Match> {
        auto matches# = Vec<Match>::new()
        auto cursor# = 0:usize
        loop cursor <= input.len() {
            auto found = self.find_from(input, cursor)
            if found.is_none() { break }
            auto next = found.unwrap()
            auto end = next.end_byte
            auto begin = next.begin_byte
            matches#.push(next)
            if end == begin {
                if cursor == input.len() { break }
                cursor = cursor + 1:usize
            } else {
                cursor = end
            }
        }
        return matches
    }

    pub fn is_match(self, input: str) -> bool {
        return self.find(input).is_some()
    }
}

pub fn package_name() -> string {
    return string::from("regex")
}
