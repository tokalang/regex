import core/option::{Option}
import core/result::{Result}
import std/vec::{Vec}
import official/regex/model::{ByteClass, Fragment, NfaState, ParsedClass, ParsedFragment, ParsedRepetition, Patch, Regex, RegexError}

const MAX_PATTERN_BYTES: usize = 4096:usize
const MAX_GROUP_NESTING: usize = 128:usize
const MAX_REPEAT_COUNT: usize = 1000:usize
const MAX_NFA_STATES: usize = 32768:usize

const STATE_LITERAL: i32 = 0:i32
const STATE_ANY: i32 = 1:i32
const STATE_SPLIT: i32 = 2:i32
const STATE_START: i32 = 3:i32
const STATE_END: i32 = 4:i32
const STATE_MATCH: i32 = 5:i32
const STATE_CLASS: i32 = 6:i32
const STATE_CAPTURE_START: i32 = 7:i32
const STATE_CAPTURE_END: i32 = 8:i32
const STATE_CAPTURE_NAME: i32 = 9:i32

const EDGE_OUT: i32 = 0:i32
const EDGE_ALT: i32 = 1:i32
const NO_STATE: i32 = -1:i32

fn error(position: usize, message: str) -> RegexError {
    return RegexError(position = position, message = string::from(message))
}

fn new_state(program#: Vec<NfaState>, kind: i32, byte: u8, class_id: i32,
             out: i32, alt: i32) -> i32 {
    auto state_id = program.len() as i32
    program#.push(NfaState(
        kind = kind,
        byte = byte,
        class_id = class_id,
        out = out,
        alt = alt
    ))
    return state_id
}

fn empty_class(negated: bool) -> ByteClass {
    return ByteClass(bits0 = 0:u64, bits1 = 0:u64, bits2 = 0:u64, bits3 = 0:u64,
                     negated = negated)
}

fn add_class_byte(class#: ByteClass, byte: u8) {
    auto shift = (byte as u64) & 63:u64
    auto bit = (1:u64) << shift:u64
    if byte < 64:u8 { class.bits0 = class.bits0 | bit }
    else if byte < 128:u8 { class.bits1 = class.bits1 | bit }
    else if byte < 192:u8 { class.bits2 = class.bits2 | bit }
    else { class.bits3 = class.bits3 | bit }
}

fn add_class_range(class#: ByteClass, first: u8, last: u8) {
    auto byte# = first
    loop true {
        add_class_byte(class, byte)
        if byte == last { break }
        byte = byte + 1:u8
    }
}

fn predefined_class(escape: u8) -> Option<ByteClass> {
    auto negated# = false
    auto kind# = escape
    if escape == 'D' as u8 || escape == 'W' as u8 || escape == 'S' as u8 {
        negated = true
        kind = escape + 32:u8
    }
    if kind != 'd' as u8 && kind != 'w' as u8 && kind != 's' as u8 {
        return Option<ByteClass>::None
    }
    auto members# = empty_class(negated)
    if kind == 'd' as u8 {
        add_class_range(members, '0' as u8, '9' as u8)
    } else if kind == 'w' as u8 {
        add_class_range(members, 'a' as u8, 'z' as u8)
        add_class_range(members, 'A' as u8, 'Z' as u8)
        add_class_range(members, '0' as u8, '9' as u8)
        add_class_byte(members, '_' as u8)
    } else {
        add_class_byte(members, ' ' as u8)
        add_class_byte(members, '\t' as u8)
        add_class_byte(members, '\n' as u8)
        add_class_byte(members, '\r' as u8)
        add_class_byte(members, 12:u8)
    }
    return Option<ByteClass>::Some(cede members)
}

fn one_patch(state_id: i32, edge: i32) -> Vec<Patch> {
    auto patches# = Vec<Patch>::new()
    patches#.push(Patch(state_id = state_id, edge = edge))
    return patches
}

fn merge_patches(cede first: Vec<Patch>, cede second: Vec<Patch>) -> Vec<Patch> {
    auto first_values = cede first
    auto second_values = cede second
    auto merged# = Vec<Patch>::new()
    auto index# = 0:usize
    loop index < first_values.len() {
        merged#.push(first_values.get(index))
        index = index + 1:usize
    }
    index = 0:usize
    loop index < second_values.len() {
        merged#.push(second_values.get(index))
        index = index + 1:usize
    }
    return merged
}

fn patch_all(program#: Vec<NfaState>, patches: Vec<Patch>, target: i32) {
    auto index# = 0:usize
    loop index < patches.len() {
        auto patch = patches.get(index)
        auto state# = program.get(patch.state_id as usize)
        if patch.edge == EDGE_OUT { state.out = target }
        else { state.alt = target }
        program#.set(patch.state_id as usize, state)
        index = index + 1:usize
    }
}

fn empty_fragment(program#: Vec<NfaState>) -> Fragment {
    auto entry = new_state(program, STATE_SPLIT, 0:u8, NO_STATE, NO_STATE, NO_STATE)
    return Fragment(entry = entry, exits = one_patch(entry, EDGE_OUT))
}

fn state_fragment(program#: Vec<NfaState>, kind: i32, byte: u8) -> Fragment {
    auto entry = new_state(program, kind, byte, NO_STATE, NO_STATE, NO_STATE)
    return Fragment(entry = entry, exits = one_patch(entry, EDGE_OUT))
}

fn class_fragment(program#: Vec<NfaState>, classes#: Vec<ByteClass>, cede members: ByteClass) -> Fragment {
    auto class_id = classes.len() as i32
    classes#.push(cede members)
    auto entry = new_state(program, STATE_CLASS, 0:u8, class_id, NO_STATE, NO_STATE)
    return Fragment(entry = entry, exits = one_patch(entry, EDGE_OUT))
}

fn capture_fragment(program#: Vec<NfaState>, capture_id: usize, cede inner: Fragment) -> Fragment {
    auto inner_entry = inner.entry
    auto inner_exits = cede inner.exits
    auto entry = new_state(program, STATE_CAPTURE_START, 0:u8, capture_id as i32,
                           inner_entry, NO_STATE)
    auto exit = new_state(program, STATE_CAPTURE_END, 0:u8, capture_id as i32,
                          NO_STATE, NO_STATE)
    patch_all(program, inner_exits, exit)
    return Fragment(entry = entry, exits = one_patch(exit, EDGE_OUT))
}

fn concat_fragments(program#: Vec<NfaState>, cede left: Fragment, cede right: Fragment) -> Fragment {
    auto entry = left.entry
    auto exits = cede left.exits
    auto next_entry = right.entry
    auto next_exits = cede right.exits
    patch_all(program, exits, next_entry)
    return Fragment(entry = entry, exits = cede next_exits)
}

fn alternate_fragments(program#: Vec<NfaState>, cede left: Fragment, cede right: Fragment) -> Fragment {
    auto left_entry = left.entry
    auto left_exits = cede left.exits
    auto right_entry = right.entry
    auto right_exits = cede right.exits
    auto entry = new_state(program, STATE_SPLIT, 0:u8, NO_STATE, left_entry, right_entry)
    return Fragment(entry = entry, exits = merge_patches(cede left_exits, cede right_exits))
}

fn star_fragment(program#: Vec<NfaState>, cede inner: Fragment) -> Fragment {
    auto inner_entry = inner.entry
    auto inner_exits = cede inner.exits
    auto entry = new_state(program, STATE_SPLIT, 0:u8, NO_STATE, inner_entry, NO_STATE)
    patch_all(program, inner_exits, entry)
    return Fragment(entry = entry, exits = one_patch(entry, EDGE_ALT))
}

fn plus_fragment(program#: Vec<NfaState>, cede inner: Fragment) -> Fragment {
    auto entry = inner.entry
    auto exits = cede inner.exits
    auto split = new_state(program, STATE_SPLIT, 0:u8, NO_STATE, entry, NO_STATE)
    patch_all(program, exits, split)
    return Fragment(entry = entry, exits = one_patch(split, EDGE_ALT))
}

fn optional_fragment(program#: Vec<NfaState>, cede inner: Fragment) -> Fragment {
    auto inner_entry = inner.entry
    auto inner_exits = cede inner.exits
    auto entry = new_state(program, STATE_SPLIT, 0:u8, NO_STATE, inner_entry, NO_STATE)
    auto skipped = one_patch(entry, EDGE_ALT)
    return Fragment(entry = entry, exits = merge_patches(cede inner_exits, cede skipped))
}

fn escaped_byte(pattern: str, position: usize) -> Result<u8, RegexError> {
    auto byte = pattern.byte_at(position) as u8
    if byte == 'x' as u8 {
        auto final_digit_position = position + 2:usize
        if final_digit_position >= pattern.len() {
            return Result<u8, RegexError>::Err(error(position, "incomplete hexadecimal regex escape"))
        }
        auto high = hex_digit(pattern.byte_at(position + 1:usize) as u8)
        auto low = hex_digit(pattern.byte_at(position + 2:usize) as u8)
        if high < 0:i32 || low < 0:i32 {
            return Result<u8, RegexError>::Err(error(position, "invalid hexadecimal regex escape"))
        }
        return Result<u8, RegexError>::Ok(((high << 4:i32) | low) as u8)
    }
    if byte == 'n' as u8 { return Result<u8, RegexError>::Ok('\n' as u8) }
    if byte == 'r' as u8 { return Result<u8, RegexError>::Ok('\r' as u8) }
    if byte == 't' as u8 { return Result<u8, RegexError>::Ok('\t' as u8) }
    if byte == '\\' as u8 || byte == '.' as u8 || byte == '^' as u8 ||
       byte == '$' as u8 || byte == '*' as u8 || byte == '+' as u8 ||
       byte == '?' as u8 || byte == '|' as u8 || byte == '(' as u8 ||
       byte == ')' as u8 || byte == '[' as u8 || byte == ']' as u8 || byte == '-' as u8 {
        return Result<u8, RegexError>::Ok(byte)
    }
    return Result<u8, RegexError>::Err(error(position, "unsupported RE2 escape in regex v1 slice"))
}

fn hex_digit(byte: u8) -> i32 {
    if byte >= '0' as u8 && byte <= '9' as u8 { return (byte - '0' as u8) as i32 }
    if byte >= 'a' as u8 && byte <= 'f' as u8 { return (byte - 'a' as u8) as i32 + 10:i32 }
    if byte >= 'A' as u8 && byte <= 'F' as u8 { return (byte - 'A' as u8) as i32 + 10:i32 }
    return -1:i32
}

fn escaped_next(position: usize, escaped: u8) -> usize {
    if escaped == 'x' as u8 { return position + 3:usize }
    return position + 1:usize
}

// Numbering belongs to the written pattern, not a particular NFA copy. This
// keeps a group inside {m,n} at one stable capture index across repetitions.
fn capture_group_at(pattern: str, opening_position: usize) -> usize {
    auto cursor# = 0:usize
    auto count# = 0:usize
    auto in_class# = false
    loop cursor < opening_position {
        auto byte = pattern.byte_at(cursor) as u8
        if byte == '\\' as u8 {
            cursor = cursor + 1:usize
            if cursor < opening_position { cursor = cursor + 1:usize }
        } else if in_class {
            if byte == ']' as u8 { in_class = false }
            cursor = cursor + 1:usize
        } else if byte == '[' as u8 {
            in_class = true
            cursor = cursor + 1:usize
        } else {
            if byte == '(' as u8 { count = count + 1:usize }
            cursor = cursor + 1:usize
        }
    }
    return count
}

fn capture_group_count(pattern: str) -> usize {
    return capture_group_at(pattern, pattern.len())
}

fn is_capture_name_start(byte: u8) -> bool {
    return byte >= 'a' as u8 && byte <= 'z' as u8 ||
           byte >= 'A' as u8 && byte <= 'Z' as u8 || byte == '_' as u8
}

fn is_capture_name_byte(byte: u8) -> bool {
    return is_capture_name_start(byte) || byte >= '0' as u8 && byte <= '9' as u8
}

// Named groups follow the two forms accepted by Rust regex: (?<name>...) and
// (?P<name>...). This returns the first byte in the group body.
fn named_group_body_start(pattern: str, opening_position: usize) -> Result<usize, RegexError> {
    auto body = opening_position + 1:usize
    if body >= pattern.len() || pattern.byte_at(body) as u8 != '?' as u8 {
        return Result<usize, RegexError>::Ok(body)
    }
    auto cursor# = body + 1:usize
    if cursor < pattern.len() && pattern.byte_at(cursor) as u8 == 'P' as u8 {
        cursor = cursor + 1:usize
    }
    if cursor >= pattern.len() || pattern.byte_at(cursor) as u8 != '<' as u8 {
        return Result<usize, RegexError>::Err(error(body, "unsupported regex group extension"))
    }
    auto name_start = cursor + 1:usize
    if name_start >= pattern.len() || !is_capture_name_start(pattern.byte_at(name_start) as u8) {
        return Result<usize, RegexError>::Err(error(name_start, "invalid regex capture name"))
    }
    cursor = name_start + 1:usize
    loop cursor < pattern.len() && pattern.byte_at(cursor) as u8 != '>' as u8 {
        if !is_capture_name_byte(pattern.byte_at(cursor) as u8) {
            return Result<usize, RegexError>::Err(error(cursor, "invalid regex capture name"))
        }
        cursor = cursor + 1:usize
    }
    if cursor >= pattern.len() {
        return Result<usize, RegexError>::Err(error(name_start, "missing closing '>' in regex capture name"))
    }
    return Result<usize, RegexError>::Ok(cursor + 1:usize)
}

fn capture_names(pattern: str) -> Result<Vec<string>, RegexError> {
    auto names# = Vec<string>::new()
    auto cursor# = 0:usize
    auto in_class# = false
    loop cursor < pattern.len() {
        auto byte = pattern.byte_at(cursor) as u8
        if byte == '\\' as u8 {
            cursor = cursor + 1:usize
            if cursor < pattern.len() { cursor = cursor + 1:usize }
        } else if in_class {
            if byte == ']' as u8 { in_class = false }
            cursor = cursor + 1:usize
        } else if byte == '[' as u8 {
            in_class = true
            cursor = cursor + 1:usize
        } else if byte != '(' as u8 {
            cursor = cursor + 1:usize
        } else {
            auto body = named_group_body_start(pattern, cursor)
            if body.is_err() { return Result<Vec<string>, RegexError>::Err(body.unwrap_err()) }
            auto body_start = body.unwrap()
            if cursor + 1:usize < pattern.len() && pattern.byte_at(cursor + 1:usize) as u8 == '?' as u8 {
                auto name_end = body_start - 1:usize
                auto name_start# = cursor + 3:usize
                if pattern.byte_at(cursor + 2:usize) as u8 == 'P' as u8 { name_start = name_start + 1:usize }
                auto name# = string::from("")
                auto name_cursor# = name_start
                loop name_cursor < name_end {
                    name#.push_byte_raw(pattern.byte_at(name_cursor) as u8)
                    name_cursor = name_cursor + 1:usize
                }
                auto index# = 0:usize
                loop index < names.len() {
                    auto &existing = names.borrow(index)
                    if existing.as_str().equals(name.as_str()) {
                        return Result<Vec<string>, RegexError>::Err(error(cursor, "duplicate regex capture name"))
                    }
                    index = index + 1:usize
                }
                names#.push(cede name)
            } else {
                names#.push(cede string::from(""))
            }
            cursor = cursor + 1:usize
        }
    }
    return Result<Vec<string>, RegexError>::Ok(cede names)
}

fn parse_class(pattern: str, position: usize) -> Result<ParsedClass, RegexError> {
    auto cursor# = position + 1:usize
    auto negated# = false
    if cursor < pattern.len() && pattern.byte_at(cursor) as u8 == '^' as u8 {
        negated = true
        cursor = cursor + 1:usize
    }
    auto members# = empty_class(negated)
    auto has_member# = false
    loop cursor < pattern.len() {
        if pattern.byte_at(cursor) as u8 == ']' as u8 {
            if !has_member {
                return Result<ParsedClass, RegexError>::Err(error(cursor, "empty regex character class"))
            }
            return Result<ParsedClass, RegexError>::Ok(ParsedClass(
                value = cede members,
                next_byte = cursor + 1:usize
            ))
        }

        auto first# = 0:u8
        if pattern.byte_at(cursor) as u8 == '\\' as u8 {
            auto escaped_position = cursor + 1:usize
            if escaped_position >= pattern.len() {
                return Result<ParsedClass, RegexError>::Err(error(cursor, "dangling character class escape"))
            }
            auto escaped = escaped_byte(pattern, escaped_position)
            if escaped.is_err() { return Result<ParsedClass, RegexError>::Err(escaped.unwrap_err()) }
            first = escaped.unwrap()
            cursor = escaped_next(escaped_position, pattern.byte_at(escaped_position) as u8)
        } else {
            first = pattern.byte_at(cursor) as u8
            cursor = cursor + 1:usize
        }

        if cursor < pattern.len() && pattern.byte_at(cursor) as u8 == '-' as u8 &&
           cursor + 1:usize < pattern.len() && pattern.byte_at(cursor + 1:usize) as u8 != ']' as u8 {
            auto dash_position = cursor
            cursor = cursor + 1:usize
            auto last# = 0:u8
            if pattern.byte_at(cursor) as u8 == '\\' as u8 {
                auto escaped_position = cursor + 1:usize
                if escaped_position >= pattern.len() {
                    return Result<ParsedClass, RegexError>::Err(error(cursor, "dangling character class escape"))
                }
                auto escaped = escaped_byte(pattern, escaped_position)
                if escaped.is_err() { return Result<ParsedClass, RegexError>::Err(escaped.unwrap_err()) }
                last = escaped.unwrap()
                cursor = escaped_next(escaped_position, pattern.byte_at(escaped_position) as u8)
            } else {
                last = pattern.byte_at(cursor) as u8
                cursor = cursor + 1:usize
            }
            if first > last {
                return Result<ParsedClass, RegexError>::Err(error(dash_position, "descending regex character range"))
            }
            add_class_range(members, first, last)
        } else {
            add_class_byte(members, first)
        }
        has_member = true
    }
    return Result<ParsedClass, RegexError>::Err(error(position, "missing closing ']'"))
}

fn parse_atom(pattern: str, position: usize, depth: usize, program#: Vec<NfaState>,
              classes#: Vec<ByteClass>)
              -> Result<ParsedFragment, RegexError> {
    if position >= pattern.len() {
        return Result<ParsedFragment, RegexError>::Err(error(position, "missing regex atom"))
    }
    auto byte = pattern.byte_at(position) as u8
    if byte == '(' as u8 {
        if depth >= MAX_GROUP_NESTING {
            return Result<ParsedFragment, RegexError>::Err(error(position, "regex group nesting limit exceeded"))
        }
        auto body = named_group_body_start(pattern, position)
        if body.is_err() { return Result<ParsedFragment, RegexError>::Err(body.unwrap_err()) }
        auto nested = parse_expression(pattern, body.unwrap(), depth + 1:usize, program, classes)
        if nested.is_err() { return Result<ParsedFragment, RegexError>::Err(nested.unwrap_err()) }
        auto parsed = nested.unwrap()
        if parsed.next_byte >= pattern.len() || pattern.byte_at(parsed.next_byte) as u8 != ')' as u8 {
            return Result<ParsedFragment, RegexError>::Err(error(parsed.next_byte, "missing closing ')'"))
        }
        auto capture_id = capture_group_at(pattern, position)
        return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
            fragment = capture_fragment(program, capture_id, cede parsed.fragment),
            next_byte = parsed.next_byte + 1:usize
        ))
    }
    if byte == '\\' as u8 {
        auto escaped_position = position + 1:usize
        if escaped_position >= pattern.len() {
            return Result<ParsedFragment, RegexError>::Err(error(position, "dangling regex escape"))
        }
        auto shorthand = predefined_class(pattern.byte_at(escaped_position) as u8)
        if shorthand.is_some() {
            return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
                fragment = class_fragment(program, classes, cede shorthand.unwrap()),
                next_byte = position + 2:usize
            ))
        }
        auto escaped = escaped_byte(pattern, escaped_position)
        if escaped.is_err() { return Result<ParsedFragment, RegexError>::Err(escaped.unwrap_err()) }
        return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
            fragment = state_fragment(program, STATE_LITERAL, escaped.unwrap()),
            next_byte = escaped_next(escaped_position, pattern.byte_at(escaped_position) as u8)
        ))
    }
    if byte == '.' as u8 {
        return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
            fragment = state_fragment(program, STATE_ANY, 0:u8),
            next_byte = position + 1:usize
        ))
    }
    if byte == '^' as u8 {
        return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
            fragment = state_fragment(program, STATE_START, 0:u8),
            next_byte = position + 1:usize
        ))
    }
    if byte == '$' as u8 {
        return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
            fragment = state_fragment(program, STATE_END, 0:u8),
            next_byte = position + 1:usize
        ))
    }
    if byte == '[' as u8 {
        auto parsed_class = parse_class(pattern, position)
        if parsed_class.is_err() {
            return Result<ParsedFragment, RegexError>::Err(parsed_class.unwrap_err())
        }
        auto class_info = parsed_class.unwrap()
        return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
            fragment = class_fragment(program, classes, cede class_info.value),
            next_byte = class_info.next_byte
        ))
    }
    if byte == '*' as u8 || byte == '+' as u8 || byte == '?' as u8 ||
       byte == '|' as u8 || byte == ')' as u8 || byte == ']' as u8 {
        return Result<ParsedFragment, RegexError>::Err(error(position, "regex operator has no preceding atom"))
    }
    return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
        fragment = state_fragment(program, STATE_LITERAL, byte),
        next_byte = position + 1:usize
    ))
}

fn decimal_digit(byte: u8) -> i32 {
    if byte >= '0' as u8 && byte <= '9' as u8 {
        return (byte - '0' as u8) as i32
    }
    return -1:i32
}

fn parse_repeat_count(pattern: str, position: usize) -> Result<ParsedRepetition, RegexError> {
    auto cursor# = position + 1:usize
    if cursor >= pattern.len() || decimal_digit(pattern.byte_at(cursor) as u8) < 0:i32 {
        return Result<ParsedRepetition, RegexError>::Err(error(position, "expected decimal repetition count"))
    }

    auto minimum# = 0:usize
    loop cursor < pattern.len() {
        auto digit = decimal_digit(pattern.byte_at(cursor) as u8)
        if digit < 0:i32 { break }
        if minimum > (MAX_REPEAT_COUNT - digit as usize) / 10:usize {
            return Result<ParsedRepetition, RegexError>::Err(error(position, "regex repetition count exceeds v1 limit"))
        }
        minimum = minimum * 10:usize + digit as usize
        cursor = cursor + 1:usize
    }

    if cursor >= pattern.len() {
        return Result<ParsedRepetition, RegexError>::Err(error(position, "missing closing '}' in repetition"))
    }
    if pattern.byte_at(cursor) as u8 == '}' as u8 {
        return Result<ParsedRepetition, RegexError>::Ok(ParsedRepetition(
            minimum = minimum, maximum = minimum as i32, next_byte = cursor + 1:usize
        ))
    }
    if pattern.byte_at(cursor) as u8 != ',' as u8 {
        return Result<ParsedRepetition, RegexError>::Err(error(cursor, "expected ',' or '}' in repetition"))
    }
    cursor = cursor + 1:usize
    if cursor < pattern.len() && pattern.byte_at(cursor) as u8 == '}' as u8 {
        return Result<ParsedRepetition, RegexError>::Ok(ParsedRepetition(
            minimum = minimum, maximum = -1:i32, next_byte = cursor + 1:usize
        ))
    }
    if cursor >= pattern.len() || decimal_digit(pattern.byte_at(cursor) as u8) < 0:i32 {
        return Result<ParsedRepetition, RegexError>::Err(error(cursor, "expected decimal repetition upper bound"))
    }

    auto maximum# = 0:usize
    loop cursor < pattern.len() {
        auto digit = decimal_digit(pattern.byte_at(cursor) as u8)
        if digit < 0:i32 { break }
        if maximum > (MAX_REPEAT_COUNT - digit as usize) / 10:usize {
            return Result<ParsedRepetition, RegexError>::Err(error(position, "regex repetition count exceeds v1 limit"))
        }
        maximum = maximum * 10:usize + digit as usize
        cursor = cursor + 1:usize
    }
    if cursor >= pattern.len() || pattern.byte_at(cursor) as u8 != '}' as u8 {
        return Result<ParsedRepetition, RegexError>::Err(error(cursor, "missing closing '}' in repetition"))
    }
    if maximum < minimum {
        return Result<ParsedRepetition, RegexError>::Err(error(position, "regex repetition upper bound is smaller than lower bound"))
    }
    return Result<ParsedRepetition, RegexError>::Ok(ParsedRepetition(
        minimum = minimum, maximum = maximum as i32, next_byte = cursor + 1:usize
    ))
}

fn parse_repeat_copy(pattern: str, atom_position: usize, depth: usize,
                     program#: Vec<NfaState>, classes#: Vec<ByteClass>)
                     -> Result<Fragment, RegexError> {
    if program.len() >= MAX_NFA_STATES {
        return Result<Fragment, RegexError>::Err(error(atom_position, "regex NFA state limit exceeded"))
    }
    auto parsed = parse_atom(pattern, atom_position, depth, program, classes)
    if parsed.is_err() { return Result<Fragment, RegexError>::Err(parsed.unwrap_err()) }
    if program.len() > MAX_NFA_STATES {
        return Result<Fragment, RegexError>::Err(error(atom_position, "regex NFA state limit exceeded"))
    }
    return Result<Fragment, RegexError>::Ok(cede parsed.unwrap().fragment)
}

fn parse_concatenation(pattern: str, position: usize, depth: usize, program#: Vec<NfaState>,
                       classes#: Vec<ByteClass>)
                       -> Result<ParsedFragment, RegexError> {
    auto current# = empty_fragment(program)
    auto has_atom# = false
    auto cursor# = position
    loop cursor < pattern.len() {
        auto byte = pattern.byte_at(cursor) as u8
        if byte == ')' as u8 || byte == '|' as u8 { break }
        auto atom = parse_atom(pattern, cursor, depth, program, classes)
        if atom.is_err() { return Result<ParsedFragment, RegexError>::Err(atom.unwrap_err()) }
        auto parsed = atom.unwrap()
        auto next# = parsed.next_byte
        auto fragment# = cede parsed.fragment
        if next < pattern.len() {
            auto quantifier = pattern.byte_at(next) as u8
            if quantifier == '*' as u8 {
                fragment = star_fragment(program, cede fragment)
                next = next + 1:usize
            } else if quantifier == '+' as u8 {
                fragment = plus_fragment(program, cede fragment)
                next = next + 1:usize
            } else if quantifier == '?' as u8 {
                fragment = optional_fragment(program, cede fragment)
                next = next + 1:usize
            } else if quantifier == '{' as u8 {
                auto repetition = parse_repeat_count(pattern, next)
                if repetition.is_err() { return Result<ParsedFragment, RegexError>::Err(repetition.unwrap_err()) }
                auto bounds = repetition.unwrap()
                auto repeated# = empty_fragment(program)
                auto produced# = 0:usize

                // Reparse each copy so every repetition owns independent NFA
                // states and unresolved exits. The first atom has already
                // validated this syntax; its unused provisional fragment is
                // discarded with this failed-to-concatenate path.
                loop produced < bounds.minimum {
                    auto copied = parse_repeat_copy(pattern, cursor, depth, program, classes)
                    if copied.is_err() { return Result<ParsedFragment, RegexError>::Err(copied.unwrap_err()) }
                    auto copy_fragment = cede copied.unwrap()
                    repeated = concat_fragments(program, cede repeated, cede copy_fragment)
                    produced = produced + 1:usize
                }

                if bounds.maximum < 0:i32 {
                    auto copied = parse_repeat_copy(pattern, cursor, depth, program, classes)
                    if copied.is_err() { return Result<ParsedFragment, RegexError>::Err(copied.unwrap_err()) }
                    auto tail = cede copied.unwrap()
                    auto starred = star_fragment(program, cede tail)
                    repeated = concat_fragments(program, cede repeated, cede starred)
                } else {
                    auto optional_count = bounds.maximum as usize - bounds.minimum
                    auto optional_index# = 0:usize
                    loop optional_index < optional_count {
                        auto copied = parse_repeat_copy(pattern, cursor, depth, program, classes)
                        if copied.is_err() { return Result<ParsedFragment, RegexError>::Err(copied.unwrap_err()) }
                        auto copy_fragment = cede copied.unwrap()
                        auto optional = optional_fragment(program, cede copy_fragment)
                        repeated = concat_fragments(program, cede repeated, cede optional)
                        optional_index = optional_index + 1:usize
                    }
                }
                if program.len() > MAX_NFA_STATES {
                    return Result<ParsedFragment, RegexError>::Err(error(next, "regex NFA state limit exceeded"))
                }
                fragment = cede repeated
                next = bounds.next_byte
            }
        }
        if has_atom {
            current = concat_fragments(program, cede current, cede fragment)
        } else {
            current = cede fragment
            has_atom = true
        }
        cursor = next
    }
    return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
        fragment = cede current,
        next_byte = cursor
    ))
}

fn parse_expression(pattern: str, position: usize, depth: usize, program#: Vec<NfaState>,
                    classes#: Vec<ByteClass>)
                    -> Result<ParsedFragment, RegexError> {
    auto first = parse_concatenation(pattern, position, depth, program, classes)
    if first.is_err() { return Result<ParsedFragment, RegexError>::Err(first.unwrap_err()) }
    auto parsed = first.unwrap()
    auto current# = cede parsed.fragment
    auto cursor# = parsed.next_byte
    loop cursor < pattern.len() && pattern.byte_at(cursor) as u8 == '|' as u8 {
        auto right = parse_concatenation(pattern, cursor + 1:usize, depth, program, classes)
        if right.is_err() { return Result<ParsedFragment, RegexError>::Err(right.unwrap_err()) }
        auto next = right.unwrap()
        current = alternate_fragments(program, cede current, cede next.fragment)
        cursor = next.next_byte
    }
    return Result<ParsedFragment, RegexError>::Ok(ParsedFragment(
        fragment = cede current,
        next_byte = cursor
    ))
}


pub fn compile_program(pattern: str) -> Result<Regex, RegexError> {
    if pattern.len() > MAX_PATTERN_BYTES {
        return Result<Regex, RegexError>::Err(error(
        MAX_PATTERN_BYTES, "regex pattern exceeds v1 size limit"))
    }
    auto names = capture_names(pattern)
    if names.is_err() { return Result<Regex, RegexError>::Err(names.unwrap_err()) }
    auto program# = Vec<NfaState>::new()
    auto classes# = Vec<ByteClass>::new()
    auto parsed = parse_expression(pattern, 0:usize, 0:usize, program, classes)
    if parsed.is_err() { return Result<Regex, RegexError>::Err(parsed.unwrap_err()) }
    auto fragment = cede parsed.unwrap()
    if fragment.next_byte != pattern.len() {
        return Result<Regex, RegexError>::Err(error(fragment.next_byte, "unexpected closing ')'"))
    }
    auto match_state = new_state(program, STATE_MATCH, 0:u8, NO_STATE, NO_STATE, NO_STATE)
    patch_all(program, fragment.fragment.exits, match_state)
    auto capture_names = names.unwrap()
    auto name_index# = 0:usize
    loop name_index < capture_names.len() {
        auto &name = capture_names.borrow(name_index)
        auto byte_index# = 0:usize
        loop byte_index < name.len() {
            new_state(program, STATE_CAPTURE_NAME, name.as_str().byte_at(byte_index) as u8,
                      name_index as i32, NO_STATE, NO_STATE)
            byte_index = byte_index + 1:usize
        }
        name_index = name_index + 1:usize
    }
    return Result<Regex, RegexError>::Ok(Regex(
        program = cede program,
        classes = cede classes,
        entry = fragment.fragment.entry,
        capture_count = capture_group_count(pattern)
    ))
}
